{
	"schemaVersion": 1,
	"id": "memehub",
	"version": "${version}",
	"name": "Meme Hub",
	"description": "Zaawansowany kliencki mod testowy do mechanik walki, automatyzacji i eksperymentow z silnikiem gry (Minecraft 26.2, Fabric).",
	"authors": [
		"Meme Hub Team"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"pl.memehub.MemeHubClient"
		]
	},
	"mixins": [
		{
			"config": "memehub.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.152.0"
	}
}
